# Private/local Compose binding. Use the gateway VM's private address in a VPC.
PRIVATE_BIND_IP=127.0.0.1

# Generate with: openssl rand -hex 32
API_KEY=replace-with-a-long-random-secret

# Used only by docker-compose.public.yml. Point this DNS name at the mail VM.
GATEWAY_DOMAIN=mail-api.example.com
# Only this public source IP may call the HTTPS API.
APP_VM_PUBLIC_IP=203.0.113.10

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_AUTH=true
SMTP_USERNAME=mailer@example.com
SMTP_PASSWORD=replace-with-app-password
SMTP_FROM_EMAIL=mailer@example.com
SMTP_FROM_NAME=My Application
SMTP_SECURITY=starttls
SMTP_TIMEOUT_SECONDS=15

LOG_LEVEL=INFO
DISABLE_DOCS=true
